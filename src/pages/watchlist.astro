---
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = [
  { no: '01', id: 'series', title: 'Series', items: [] },
  {
    no: '02',
    id: 'anime',
    title: 'Anime',
    items: [
      { seed: 'w-frieren', title: 'Frieren: Beyond Journey’s End', meta: '2023 · Madhouse', note: '“Anime terbaik dua dekade terakhir. No debat.”', statusClass: 'yt', status: '↗ tersedia di YouTube' },
      { seed: 'w-vinland', title: 'Vinland Saga S1', meta: '2019 · Wit Studio', note: '“Aku tidak punya musuh. 🪓”', statusClass: 'ok', status: '✓ koleksi pribadi' },
      { seed: 'w-mob', title: 'Mob Psycho 100', meta: '2016 · Bones', note: '“Nunggu mood rewatch yang pas.”', statusClass: 'no', status: '✕ belum ada file' },
      { seed: 'w-abyss', title: 'Made in Abyss', meta: '2017 · Kinema Citrus', note: '“Imut di luar, traumatis di dalam.”', statusClass: 'ok', status: '✓ koleksi pribadi' },
    ],
  },
  {
    no: '03',
    id: 'movie',
    title: 'Movie',
    items: [
      { seed: 'w-interstellar', title: 'Interstellar', meta: '2014 · Christopher Nolan', note: '“Relate sama ending-nya setiap rewatch.”', statusClass: 'ok', status: '✓ koleksi pribadi' },
      { seed: 'w-whiplash', title: 'Whiplash', meta: '2014 · Damien Chazelle', note: '“Tensi drumnya bikin ikut sesak napas.”', statusClass: 'ok', status: '✓ koleksi pribadi' },
      { seed: 'w-raid', title: 'The Raid', meta: '2011 · Gareth Evans', note: '“Wajib — nunggu file rapi dulu.”', statusClass: 'no', status: '✕ belum ada file' },
      { seed: 'w-chihiro', title: 'Spirited Away', meta: '2001 · Studio Ghibli', note: '“Comfort film sepanjang masa.”', statusClass: 'ok', status: '✓ koleksi pribadi' },
      { seed: 'w-yourname', title: 'Your Name', meta: '2016 · Makoto Shinkai', note: '“Soundtracknya masih nyangkut di kepala.”', statusClass: 'yt', status: '↗ tersedia di YouTube' },
    ],
  },
  {
    no: '04',
    id: 'dokumenter',
    title: 'Dokumenter',
    items: [
      { seed: 'w-ocean', title: 'Samudra Dalam', meta: 'Klip pilihan · rasa-rasa NatGeo', note: '“Biar ingat dunia masih lebih besar dari deadline.”', statusClass: 'yt', status: '↗ tersedia di YouTube' },
      { seed: 'w-atacama', title: 'Langit Malam Atacama', meta: 'Short · 15 detik, tapi bikin tenang', note: '“Diputar pas lagi overthinking.”', statusClass: 'ok', status: '✓ koleksi pribadi' },
    ],
  },
  { no: '05', id: 'adult', title: '18+', items: [] },
];
---

<BaseLayout
  title="Watchlist — vibes·arr"
  description="Film, anime, series, dan tontonan pendek yang berulang kali kutonton — plus antrean yang nggak pernah menyusut."
  acc="watch"
  page="watchlist"
>
  <section class="p-hero">
    <div class="wrap">
      <p class="crumb">rak / tontonan</p>
      <h1>Watchlist</h1>

      <div class="p-stats">
        <span><b>4</b> anime</span>
        <span><b>Live</b> dari API</span>
        <span><b>5</b> movie</span>
        <span><b>2</b> dokumenter</span>
      </div>

      <div class="legend">
        <span><i class="lg" style="background:var(--c-read)"></i> ✓ koleksi pribadi</span>
        <span><i class="lg" style="background:var(--c-watch)"></i> ↗ tersedia di YouTube</span>
        <span><i class="lg" style="background:#8b8175"></i> ✕ belum ada file</span>
        <span><i class="lg" style="background:var(--c-games)"></i> ▶ dari API (klik = daftar episode)</span>
      </div>
    </div>
  </section>

  {
    sections.map((section) => (
      <section class="w-sec wrap">
        <div class="sec-head">
          <span class="no">{section.no} /</span>
          <h2>{section.title}</h2>
          <span class="rule"></span>
          <span class="more" id={`count-${section.id}`}>{section.items.length} judul</span>
        </div>

        <div class="w-grid" id={`grid-${section.id}`} data-stagger>
          {section.items.length === 0 ? (
            <p class="fine" style="grid-column:1/-1" data-empty={section.id}>
              {section.id === 'series'
                ? 'mengambil daftar dari API…'
                : 'rak ini masih kosong — atau memang sebaiknya begitu 😌'}
            </p>
          ) : (
            section.items.map((item) => (
              <article class:list={['poster', 'rv', { off: item.statusClass === 'no' }]}>
                <div class="p-cover">
                  <img
                    src={`https://picsum.photos/seed/${item.seed}/480/270`}
                    alt={`Poster ${item.title}`}
                    width="480"
                    height="270"
                    loading="lazy"
                    decoding="async"
                    onerror="this.onerror=null;this.src='/images/placeholder.svg'"
                  />
                  <span class={`p-status ${item.statusClass}`}>{item.status}</span>
                </div>
                <div class="p-meta">
                  <strong>{item.title}</strong>
                  <span>{item.meta}</span>
                  <p class="p-note">{item.note}</p>
                </div>
              </article>
            ))
          )}
        </div>
      </section>
    ))
  }

  <script>
    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => (
      { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
    ));

    // Sampul generated (inisial judul) — API tidak mengirim gambar
    const coverFor = (title) => {
      const ch = esc((title || '?').trim().charAt(0).toUpperCase() || '?');
      const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="480" height="270"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#2a241f"/><stop offset="1" stop-color="#141110"/></linearGradient></defs><rect width="480" height="270" fill="url(#g)"/><text x="240" y="175" font-family="monospace" font-size="120" fill="#79c0ff" opacity=".85" text-anchor="middle">${ch}</text></svg>`;
      return 'data:image/svg+xml;utf8,' + encodeURIComponent(svg);
    };

    // Fallback mapping kategori -> section (jika proxy versi lama tidak mengirim field `section`)
    const CAT_TO_SECTION = {
      series: 'series',
      anime: 'anime',
      movie: 'movie',
      film: 'movie',
      dokumenter: 'dokumenter',
      documentary: 'dokumenter',
      '18+': 'adult',
      adult: 'adult',
    };

    const SECTION_IDS = ['anime', 'series', 'movie', 'dokumenter', 'adult'];

    const cardHtml = (s) => `
      <a class="poster rv in" href="/series/${encodeURIComponent(s.id)}">
        <div class="p-cover">
          <img src="${coverFor(s.title)}" alt="" width="480" height="270" loading="lazy">
          <span class="p-status yt">▶ ${s.episodes ?? 0} ep</span>
        </div>
        <div class="p-meta">
          <strong>${esc(s.title)}</strong>
          <span>${s.year ?? '—'} · ${esc(s.category)}</span>
          <p class="p-note">${s.episodes ?? 0} episode · klik untuk daftar episode →</p>
        </div>
      </a>
    `;

    async function loadWatchlists() {
      let items = [];
      let failed = false;

      try {
        const r = await fetch('/api/watchlists');
        if (r.ok) items = await r.json();
        else failed = true;
      } catch (err) {
        failed = true;
        console.warn('Gagal memuat watchlist dari API.', err);
      }
      if (!Array.isArray(items)) items = [];

      // Kelompokkan item API berdasarkan section
      const perSection = {};
      items.forEach((s) => {
        const sec = s.section || CAT_TO_SECTION[String(s.category ?? '').toLowerCase().trim()];
        if (!sec) {
          console.warn('Kategori watchlist tidak dikenal, dilewati:', s.category);
          return;
        }
        (perSection[sec] = perSection[sec] || []).push(s);
      });

      // Sisipkan ke grid masing-masing section + perbarui hitungan
      SECTION_IDS.forEach((id) => {
        const grid = document.getElementById(`grid-${id}`);
        const count = document.getElementById(`count-${id}`);
        if (!grid) return;

        const list = perSection[id] || [];
        const emptyMsg = grid.querySelector('[data-empty]');

        if (list.length) {
          emptyMsg?.remove();
          grid.insertAdjacentHTML('beforeend', list.map(cardHtml).join(''));
        } else if (emptyMsg && id === 'series') {
          emptyMsg.textContent = failed ? 'gagal memuat daftar dari API.' : 'belum ada series di API.';
        }

        if (count) count.textContent = `${grid.querySelectorAll('.poster').length} judul`;
      });
    }

    loadWatchlists();
  </script>
</BaseLayout>