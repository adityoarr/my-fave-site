---
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = [
  {
    no: '01',
    title: 'Film',
    items: [
      {
        seed: 'w-interstellar',
        title: 'Interstellar',
        meta: '2014 · Christopher Nolan',
        note: '“Relate sama ending-nya setiap rewatch.”',
        statusClass: 'ok',
        status: '✓ koleksi pribadi',
      },
      {
        seed: 'w-whiplash',
        title: 'Whiplash',
        meta: '2014 · Damien Chazelle',
        note: '“Tensi drumnya bikin ikut sesak napas.”',
        statusClass: 'ok',
        status: '✓ koleksi pribadi',
      },
      {
        seed: 'w-raid',
        title: 'The Raid',
        meta: '2011 · Gareth Evans',
        note: '“Wajib — nunggu file rapi dulu.”',
        statusClass: 'no',
        status: '✕ belum ada file',
      },
      {
        seed: 'w-chihiro',
        title: 'Spirited Away',
        meta: '2001 · Studio Ghibli',
        note: '“Comfort film sepanjang masa.”',
        statusClass: 'ok',
        status: '✓ koleksi pribadi',
      },
      {
        seed: 'w-yourname',
        title: 'Your Name',
        meta: '2016 · Makoto Shinkai',
        note: '“Soundtracknya masih nyangkut di kepala.”',
        statusClass: 'yt',
        status: '↗ tersedia di YouTube',
      },
    ],
  },
  {
    no: '02',
    title: 'Anime',
    items: [
      {
        seed: 'w-frieren',
        title: 'Frieren: Beyond Journey’s End',
        meta: '2023 · Madhouse',
        note: '“Anime terbaik dua dekade terakhir. No debat.”',
        statusClass: 'yt',
        status: '↗ tersedia di YouTube',
      },
      {
        seed: 'w-vinland',
        title: 'Vinland Saga S1',
        meta: '2019 · Wit Studio',
        note: '“Aku tidak punya musuh. 🪓”',
        statusClass: 'ok',
        status: '✓ koleksi pribadi',
      },
      {
        seed: 'w-mob',
        title: 'Mob Psycho 100',
        meta: '2016 · Bones',
        note: '“Nunggu mood rewatch yang pas.”',
        statusClass: 'no',
        status: '✕ belum ada file',
      },
      {
        seed: 'w-abyss',
        title: 'Made in Abyss',
        meta: '2017 · Kinema Citrus',
        note: '“Imut di luar, traumatis di dalam.”',
        statusClass: 'ok',
        status: '✓ koleksi pribadi',
      },
    ],
  },
  {
    no: '03',
    title: 'Dokumenter & Shorts',
    items: [
      {
        seed: 'w-ocean',
        title: 'Samudra Dalam',
        meta: 'Klip pilihan · rasa-rasa NatGeo',
        note: '“Biar ingat dunia masih lebih besar dari deadline.”',
        statusClass: 'yt',
        status: '↗ tersedia di YouTube',
      },
      {
        seed: 'w-atacama',
        title: 'Langit Malam Atacama',
        meta: 'Short · 15 detik, tapi bikin tenang',
        note: '“Diputar pas lagi overthinking.”',
        statusClass: 'ok',
        status: '✓ koleksi pribadi',
      },
    ],
  },
];
---

<BaseLayout
  title="Watchlist — vibes·arr"
  description="Film, anime, dan tontonan pendek yang berulang kali kutonton — plus antrean yang nggak pernah menyusut."
  acc="watch"
  page="watchlist"
>
  <section class="p-hero">
    <div class="wrap">
      <p class="crumb">rak / tontonan</p>
      <h1>Watchlist<span class="p-dot">.</span></h1>

      <p class="lead">
        Film, anime, dan tontonan pendek yang berulang kali kutonton — plus
        antrean yang nggak pernah menyusut. Rak ini murni katalog:
        <b>tidak ada player maupun embed di sini</b>.
      </p>

      <div class="p-stats">
        <span><b>11</b> judul</span>
        <span><b>6</b> koleksi pribadi</span>
        <span><b>3</b> tersedia di YouTube</span>
        <span><b>2</b> menunggu file</span>
      </div>

      <div class="legend">
        <span><i class="lg" style="background:var(--c-read)"></i> ✓ koleksi pribadi (file tersimpan)</span>
        <span><i class="lg" style="background:var(--c-watch)"></i> ↗ tersedia di YouTube</span>
        <span><i class="lg" style="background:#8b8175"></i> ✕ belum ada file</span>
      </div>

      <p class="fine">
        * tidak ada video player atau embed YouTube di halaman ini — semua
        status murni catatan katalog pribadi.
      </p>
    </div>
  </section>

  {
    sections.map((section) => (
      <section class="w-sec wrap">
        <div class="sec-head">
          <span class="no">{section.no} /</span>
          <h2>{section.title}</h2>
          <span class="rule"></span>
          <span class="more">{section.items.length} judul</span>
        </div>

        <div class="w-grid" data-stagger>
          {
            section.items.map((item) => (
              <article class:list={['poster', 'rv', { off: item.statusClass === 'no' }]}>
                <div class="p-cover">
                  <img
                    src={`https://picsum.photos/seed/${item.seed}/400/600`}
                    alt={`Poster ${item.title}`}
                    width="400"
                    height="600"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class={`p-status ${item.statusClass}`}>{item.status}</span>
                </div>

                <div class="p-meta">
                  <strong>{item.title}</strong>
                  <span>{item.meta}</span>
                  <p class="p-note">{item.note}</p>
                </div>
              </article>
            ))
          }
        </div>
      </section>
    ))
  }
</BaseLayout>