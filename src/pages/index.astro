  {
    no: 'R-01',
    href: '/listen',
    name: 'Listen',
    count: '16 trek · 4 kategori',
    color: 'var(--c-listen)',
  },
  {
    no: 'R-02',
    href: '/watchlist',
    name: 'Watchlist',
    count: '11 judul · 9 bisa diputar',
    color: 'var(--c-watch)',
