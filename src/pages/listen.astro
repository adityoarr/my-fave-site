---
import BaseLayout from '../layouts/BaseLayout.astro';

const audioBase = 'https://www.soundhelix.com/examples/mp3/SoundHelix-Song-';

// Filter categories (tanpa "youtube" lagi)
const filters = [
  { value: 'all', label: 'Semua' },
  { value: 'ost', label: 'OST Anime' },
  { value: 'non', label: 'Non-Anime' },
  { value: 'remix', label: 'Remix' },
  { value: 'instrumental', label: 'Instrumental' },
  { value: 'islamic', label: 'Islamic' },
];

// Data fallback (akan ditimpa API saat halaman dibuka)
const groups = [
  {
    id: 'ost',
    title: 'OST Anime',
    tracks: [
      { idx: '01', title: 'Memuat dari API...', meta: 'Harap tunggu', img: 'tr-lofi', dur: '--:--', type: 'yt' },
    ],
  },
  {
    id: 'non',
    title: 'Non-Anime',
    tracks: [
      { idx: '01', title: 'Memuat dari API...', meta: 'Harap tunggu', img: 'tr-lofi', dur: '--:--', type: 'yt' },
    ],
  },
  {
    id: 'remix',
    title: 'Remix',
    tracks: [],
  },
  {
    id: 'instrumental',
    title: 'Instrumental',
    tracks: [],
  },
  {
    id: 'islamic',
    title: 'Islamic',
    tracks: [],
  },
];
---

<BaseLayout
  title="Listen — vibes·arr"
  description="Soundtrack hidupku beberapa bulan terakhir. Beberapa bisa langsung diputar, beberapa masih arsip fisik."
  acc="listen"
  page="listen"
>
  <style is:inline>
    /* channel link di daftar trek YouTube */
    .t-channel{
      display:block;
      font-size:.78rem;
      color:var(--c-watch);
      text-decoration:none;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
      position:relative;
      padding-right:14px;
      transition:color .2s ease;
    }
    .t-channel::after{
      content:'↗';
      position:absolute;
      right:0;
      top:50%;
      transform:translateY(-50%) scale(.9);
      opacity:.5;
      transition:.25s;
    }
    .t-channel:hover{
      color:var(--ink);
      text-decoration:underline;
      text-underline-offset:3px;
    }
    .t-channel:hover::after{
      opacity:1;
      transform:translateY(-50%) scale(1);
    }
    .t-channel:focus-visible{
      outline:2px solid var(--c-watch);
      outline-offset:2px;
      border-radius:3px;
    }

    /* Floating YouTube Player */
    .yt-player-wrap {
      position: fixed;
      bottom: 110px;
      right: 24px;
      width: 320px;
      height: 180px;
      background: #000;
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 24px 48px rgba(0,0,0,.65);
      border: 1px solid var(--line);
      z-index: 80;
      transform: translateY(20px) scale(0.95);
      opacity: 0;
      pointer-events: none;
      transition: all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .yt-player-wrap.show {
      transform: translateY(0) scale(1);
      opacity: 1;
      pointer-events: auto;
    }
    .yt-player-wrap.video-hidden {
      transform: translate(-9999px, -9999px);
      opacity: 0;
      pointer-events: none;
    }
    .yt-player-wrap iframe {
      width: 100%;
      height: 100%;
      border: 0;
    }
    .yt-close-btn,
    .yt-min-btn {
      position: absolute;
      top: 8px;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: rgba(0,0,0,.75);
      color: #fff;
      border: 1px solid rgba(255,255,255,.1);
      display: grid;
      place-items: center;
      font-size: 0.75rem;
      z-index: 2;
      transition: background 0.2s;
    }
    .yt-close-btn { right: 8px; }
    .yt-min-btn { left: 8px; }
    .yt-close-btn:hover {
      background: var(--c-listen);
      color: var(--dark);
      border-color: var(--c-listen);
    }
    .yt-min-btn:hover {
      background: var(--c-watch);
      color: var(--dark);
      border-color: var(--c-watch);
    }
    .yt-restore {
      position: fixed;
      right: 24px;
      bottom: 110px;
      z-index: 80;
      width: 46px;
      height: 46px;
      border-radius: 50%;
      background: var(--acc);
      color: var(--dark);
      display: grid;
      place-items: center;
      font-size: 1rem;
      box-shadow: 0 12px 30px rgba(0,0,0,.55);
      opacity: 0;
      pointer-events: none;
      transform: translateY(10px);
      transition: 0.3s;
    }
    .yt-restore.show {
      opacity: 1;
      pointer-events: auto;
      transform: none;
    }
    @media (max-width: 780px) {
      .yt-player-wrap {
        width: calc(100% - 48px);
        right: 24px;
        bottom: 180px;
        height: 200px;
      }
      .yt-restore { bottom: 180px; }
    }
  </style>

  <section class="p-hero">
    <div class="wrap">
      <p class="crumb">rak / dengerin</p>
      <h1>Listen</h1>

      <p class="lead">
        Soundtrack hidupku beberapa bulan terakhir. Beberapa bisa langsung
        diputar di sini, beberapa cuma numpang nama karena filenya masih di
        kaset/vinyl 😅
      </p>

      <div class="p-stats">
        <span><b>Live</b> API sync</span>
        <span><b>5</b> kategori</span>
        <span>mode: urutan sakral, no shuffle</span>
      </div>

      <div class="legend">
        <span><i class="lg" style="background:var(--c-read)"></i> audio lokal</span>
        <span><i class="lg" style="background:var(--c-watch)"></i> via YouTube</span>
      </div>
    </div>
  </section>

  <div class="filters wrap">
    {
      filters.map((filter, index) => (
        <button
          type="button"
          class:list={['fbtn', { on: index === 0 }]}
          data-filter={filter.value}
        >
          {filter.label}
        </button>
      ))
    }
  </div>

  {
    groups.map((group) => (
      <section class="group wrap" data-group={group.id}>
        <div class="g-head">
          <h3>{group.title}</h3>
          <span class="g-count">{group.tracks.length} trek</span>
          <span class="g-line"></span>
        </div>

        <ul class="tracks" data-stagger>
          {
            group.tracks.map((track) => (
              <li
                class:list={['track', 'rv']}
                data-cat={group.id}
                data-src={track.src}
                data-yt={track.yt}
                data-type={track.type}
              >
                <span class="t-idx">{track.idx}</span>

                <button
                  type="button"
                  class="t-play"
                  aria-label={track.src || track.yt ? `Putar ${track.title}` : `${track.title} tanpa player`}
                >
                  {(track.src || track.yt) ? '▶' : '✕'}
                </button>

                <img
                  src={track.yt ? `https://img.youtube.com/vi/${track.yt}/mqdefault.jpg` : `https://picsum.photos/seed/${track.img}/90/90`}
                  alt=""
                  width="44"
                  height="44"
                  loading="lazy"
                  decoding="async"
                  onerror="this.src='/images/placeholder.svg'"
                />

                <div class="t-info">
                  <strong>{track.title}</strong>
                  <span>{track.meta}</span>
                </div>

                <span class="t-dur">{track.dur}</span>

                <span class:list={['t-status', (track.src || track.yt) ? 'ok' : 'no']}>
                  {track.src ? '● audio lokal' : track.yt ? '● via YouTube' : '✕ tanpa player'}
                </span>

                <span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
              </li>
            ))
          }
        </ul>
      </section>
    ))
  }

  <!-- Floating YouTube Player -->
  <div id="ytPlayerWrap" class="yt-player-wrap">
    <div id="ytPlayerFrame"></div>
    <button id="ytMinBtn" class="yt-min-btn" aria-label="Sembunyikan video">🙈</button>
    <button id="ytCloseBtn" class="yt-close-btn" aria-label="Tutup player">✕</button>
  </div>
  <button id="ytRestoreBtn" class="yt-restore" aria-label="Tampilkan video">♫</button>

  <div id="nowbar" class="nowbar">
    <div class="wrap nb-in">
      <div class="nb-left">
        <div class="disc"></div>
        <div class="nb-meta">
          <strong id="nbTitle">—</strong>
          <span id="nbArtist">—</span>
        </div>
      </div>

      <div class="nb-mid">
        <div class="nb-ctrl">
          <button id="nbPrev" class="nb-btn" type="button" aria-label="Trek sebelumnya">⏮</button>
          <button id="nbPlay" class="nb-btn main" type="button" aria-label="Putar / jeda">▶</button>
          <button id="nbNext" class="nb-btn" type="button" aria-label="Trek berikutnya">⏭</button>
        </div>

        <div class="nb-row">
          <span id="nbCur" class="nb-time">0:00</span>
          <div id="nbBar" class="bar">
            <div id="nbFill" class="fill"></div>
          </div>
          <span id="nbDur" class="nb-time">0:00</span>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>