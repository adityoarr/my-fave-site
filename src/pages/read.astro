---

<BaseLayout
  title="Read — rakku"
  description="Manga, manhwa, manhua, novel, sampai majalah. Bacaan tidak diputar di sini — tapi progresnya kucatat."
  acc="read"
  page="read"
>
  <section class="p-hero">
    <div class="wrap">
      <p class="crumb">rak / bacaan</p>
      <h1>Read</h1>

      <p class="lead">
        Manga, manhwa, manhua, novel, sampai majalah. Bacaan tidak diputar di
        sini — tapi progresnya kucatat. Pencet <b>+1</b> kalau baru selesai satu
        bab/halaman 😉
      </p>

      <div class="p-stats">
        <span><b>10</b> bacaan</span>
        <span><b>5</b> genre</span>
        <span><b>3</b> tamat</span>
        <span>rekor: 14 bab sekali duduk</span>
      </div>
    </div>
  </section>

  <div class="filters wrap">
    {
      filters.map((filter, index) => (
        <button
          class:list={['fbtn', { on: index === 0 }]}
          data-filter={filter.value}
          type="button"
        >
          {filter.label}
        </button>
      ))
    }
  </div>

  <div class="r-grid wrap" data-stagger>
    {
      books.map((book) => (
        <article
          class:list={['book', 'rv', { done: book.cur >= book.max }]}
          data-cat={book.cat}
          data-key={book.key}
          data-unit={book.unit}
          data-cur={book.cur}
          data-max={book.max}
        >
          <div class="b-cover">
            <img
              src={`https://picsum.photos/seed/${book.seed}/400/560`}
              alt={`Sampul ${book.title}`}
              width="400"
              height="560"
              loading="lazy"
            />
            <span class="b-cat chip read">{book.catLabel}</span>
          </div>

          <div class="b-body">
            <strong class="b-title">{book.title}</strong>
            <span class="b-author">{book.author}</span>
            <p class="b-note">{book.note}</p>

            <div class="prog">
              <i></i>
            </div>

            <div class="b-meta">
              <span class="b-count">{book.unit} 0/0</span>
              <span class="b-pct">0%</span>
            </div>

            <div class="b-actions">
              <button class="b-add" type="button">
                ＋1 {book.unit === 'ch' ? 'bab' : 'hal'}
              </button>
              <span class:list={['b-flag', { 'done-f': book.cur >= book.max }]}>
                {book.flag}
              </span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</BaseLayout>